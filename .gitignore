# Python bytecode and runtime caches
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables
.env
.env.*
!.env.example

# Logs
*.log
logs/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# Build and packaging artifacts
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Test, coverage, and quality-tool output
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# Runtime screenshots — ignore contents but keep folder
assets/screenshots/*
!assets/screenshots/.gitkeep

# MediaPipe model files — ignore contents but keep folder
assets/models/*
!assets/models/.gitkeep

# OS metadata files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
*.bak

# Local databases
*.db
*.sqlite3

# Cursor / OpenCode editor config
.cursor/
.opencode/

# Jupyter notebook checkpoints
.ipynb_checkpoints/
